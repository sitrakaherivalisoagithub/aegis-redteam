# Aegis AI Red Team - Environment Configuration

# 1. API Configuration
# Base URL for the FastAPI backend (used by the Streamlit frontend)
API_BASE_URL=http://127.0.0.1:8000/api/v1

# 2. Database Configuration
# Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./aegis.db

# 3. LLM Provider Credentials
# Set ONE of the following depending on your Google setup:

# Option A: Gemini Developer API (Studio)
GOOGLE_API_KEY=your_google_api_key_here

# Option B: Google Cloud Vertex AI (Enterprise) with Service Account
# This is the primary and recommended authentication method.
SA_FILE_PATH=/absolute/path/to/your/service-account-key.json
# Fallbacks for ADC if SA_FILE_PATH is not provided:
GEMINI_PROJECT_ID=your_gcp_project_id_here
GEMINI_LOCATION=us-central1
MODEL_NAME=gemini-1.5-pro-preview-0409

# 4. Observability (Optional - LangSmith)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=aegis-red-team
